# ── LLM Provider ──────────────────────────
# Uncomment and set the API key for your provider
# OPENROUTER_API_KEY=sk-or-v1-xxx
# ZHIPU_API_KEY=xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# OPENAI_API_KEY=sk-xxx
# GEMINI_API_KEY=xxx
# MODELSCOPE_API_KEY=xxx
# CLAUDE_CODE_OAUTH=xxx
# ── Chat Channel ──────────────────────────
# TELEGRAM_BOT_TOKEN=123456:ABC...
# DISCORD_BOT_TOKEN=xxx
# Feishu (飞书)
# PICOCLAW_CHANNELS_FEISHU_APP_ID=cli_xxx
# PICOCLAW_CHANNELS_FEISHU_APP_SECRET=xxx
# PICOCLAW_CHANNELS_FEISHU_RANDOM_REACTION_EMOJI=Typing,OneSecond

# ── Web Search (optional) ────────────────
# BRAVE_SEARCH_API_KEY=BSA...

# ── Memory / GC (optional, for low-RAM devices) ──
# Soft memory limit in MB: when the process approaches it the GC runs more
# aggressively instead of growing the heap further.
# PICOCLAW_MEMORY_LIMIT_MB=64
# GC target percentage (equivalent to GOGC). Use -1 or "off" to disable the GC
# and rely on PICOCLAW_MEMORY_LIMIT_MB alone.
# PICOCLAW_GOGC=100

# ── Timezone ──────────────────────────────
TZ=Asia/Shanghai
